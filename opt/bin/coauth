#!/usr/bin/env zsh

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "usage: coauth [search text]"
    echo ""
    echo "Copies a 'Co-authored-by:' trailer to the clipboard, for pasting into a commit message."
    echo "With no argument, copies the most recent Co-authored-by line found in git log."
    echo "With a search text argument, copies the most recent Co-authored-by (or Author, rewritten"
    echo "as Co-authored-by) line whose text matches."
    return 0
fi

if [[ $# -eq 0 ]]; then
    result=$(git log | grep -i "co-authored-by:" | head -n 1 | xargs echo)
    if [[ -z "$result" ]]; then
        echo "[!] No previous Co-authored-by line found."
        return 1
    fi
    echo "$result" | pbcopy
    echo "[copied] $result"
else
    msg="$*"
    result=$(git log | grep -i "co-authored-by:" | grep -i "$msg" | head -n 1 | xargs echo)
    if [[ -z "$result" ]]; then
        result=$(git log | grep -i "author:" | grep -i "$msg" | head -n 1 | xargs echo | sed 's/Author:/Co-authored-by:/')
    fi
    if [[ -z "$result" ]]; then
        echo "[!] No previous Author or Co-authored-by line found containing '$msg'."
        return 1
    fi
    echo "$result" | pbcopy
    echo "[copied] $result"
fi
